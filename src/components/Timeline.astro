---
import { Icon } from "astro-icon/components";
const timeline = [
	{
		date: "Nov 2023 – Present",
		role: "Platform Manager & DevOps Engineer",
		location: "Crosskey - Åland Islands, Finland",
		description:
			"I work cross-functionally with Platform Managers, DBAs, Architects and Product Owners to design and deliver technical solutions aligned with team strategy. I drive development, quality assurance, and operational excellence while supporting developers with the tools and infrastructure they need to move fast—and initiating improvements where friction exists.",
	},
	{
		date: "Jun 2022 – Jul 2023",
		role: "Backend Developer",
		location: "Enfuce - Åland Islands, Finland",
		description:
			'Design and built backend microservices using Java/Spring Boot and TypeScript/Node.js, deployed across AWS. Contributed to optimize for reliability and scalability and collaborate with the broader platform team to ensure our services support developer workflows and business objectives.',
	},
	{
		date: "Aug 2020 – Apr 2022",
		role: "DevOps Engineer",
		location: "Paf (Games Sports Casino) - Åland Islands, Finland",
		description:
			"Helped with the CI/CD pipeline architecture and optimization, streamlining deployments for Java/Spring Boot microservices on AWS. I maintain system reliability through rotational on-call support and coordinated release management, troubleshooting incidents and driving operational improvements to reduce friction and incident impact. Started working remotely from the Philippines during the pandemic and moved to Finland in 2021 to continue working with Paf on-site.",
	},
	{
		date: "Jul 2018 - May 2020",
		role: "Technical Manager",
		location: "Novare Technologies - Philippines",
		description:
			"While still thinking of my career path, I joined a medium-sized software company as a Technical Manager. I was responsible for release management, deployment management, task management, R&D, risk management and monitoring 4 employees when it comes to career growth and development.",
	},
	{
		date: "Jan 2011 – May 2017",
		role: "Lead Software Engineer",
		location: "Accenture - Philippines",
		description:
			"Started as a Senior Software Engineer, I was promoted to Lead Software Engineer after 2 years. I was responsible for leading a team of 5-10 developers, managing project timelines and ensuring the successful delivery of software solutions. I also played a key role in mentoring junior developers and fostering a collaborative team environment.",
	},
];
---

<div class="space-y-16">
	{
		timeline.map((item, index) => (
			<div class="grid grid-cols-1 md:grid-cols-4">
				<div class="text-slate-400">{item.date}</div>
				<div class="col-span-3 flex flex-col gap-y-3">
					<div class="font-semibold">{item.role}</div>
					<div class="flex items-center space-x-1">
						<Icon name="heroicons:map-pin" />
						<span>{item.location}</span>
					</div>
					<div>{item.description}</div>
				</div>
			</div>
		))
	}
</div>
