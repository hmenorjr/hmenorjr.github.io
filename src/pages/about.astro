---
import BaseLayout from "../layouts/BaseLayout.astro";
import Projects from "../components/Projects.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import Timeline from "../components/Timeline.astro";
import Social from "../components/Social.astro";
import { Icon } from "astro-icon/components";

// SEO properties
const title = "About";
const description = "All about me";
---

<BaseLayout title={title} description={description}>
	<div class="mx-auto max-w-2xl lg:max-w-4xl">
		<header class="max-w-2xl">
			<h1 class="text-4xl md:text-6xl font-black tracking-tight mb-8">
				About
			</h1>
		</header>

		<section class="max-w-2xl">
			<div class="space-y-8 leading-8">
				<p>
					I began as a junior developer and spent 10+ years progressing through backend development and systems operations roles. 
					Platform engineering became my specialty—designing reliable infrastructure, streamlining deployments and enabling teams to move faster. 
					I now work from Finland, applying those lessons to platform and DevOps challenges.
				</p>
				<p>
					When I'm not focused on platform engineering, I build websites and landing pages for local businesses—bringing 
					the same rigor around performance, reliability, and user experience from my infrastructure work into frontend and design work.
				</p>
				<p>
					This blog is where I share deep dives into platform engineering, DevOps practices, and the operational lessons 
					I've learned over a decade of building and maintaining distributed systems. I write about the technical decisions 
					that matter—CI/CD pipelines, infrastructure design, scaling challenges, and the messy realities of production systems. 
					If you're navigating similar problems or curious about platform engineering, you'll find something useful here.
				</p>
			</div>

			<div
				class="sm:flex sm:items-center sm:justify-between space-y-4 sm:space-y-0 my-10"
			>
				<a
					href="mailto:hermanmjr@icloud.com"
					class="flex items-center space-x-1 hover:text-primary-500"
				>
					<Icon name="heroicons:envelope" class="size-5" />
					<span>hermanmjr@icloud.com</span>
				</a>
				<div class="flex items-center space-x-4">
					<Social />
				</div>
			</div>
		</section>

		<section class="my-16 sm:my-30">
			<h2
				class="text-2xl sm:text-4xl font-bold tracking-tight mb-10 sm:mb-20"
			>
				Career Snapshot
			</h2>

			<div>
				<Timeline />
			</div>
		</section>
	</div>

	<div class="my-16 sm:my-30">
		<div class="mx-auto lg:max-w-4xl">
			<h2
				class="text-2xl sm:text-4xl font-bold tracking-tight mb-10 sm:mb-20"
			>
				Projects
			</h2>
		</div>

		<div class="mx-auto lg:max-w-5xl">
			<Projects />
		</div>
	</div>

	<!-- <div class="mx-auto lg:max-w-4xl my-16 sm:my-30">
		<NewsletterForm />
	</div> -->
</BaseLayout>
